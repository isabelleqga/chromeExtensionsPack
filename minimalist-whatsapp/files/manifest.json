{
  "manifest_version": 3,
  "name": "Minimalist WhatsApp",
  "version": "9.0",
  "description": "Lets you hide navbar, chatlist, and chat card elements on WhatsApp Web, organized into tabs by area.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}